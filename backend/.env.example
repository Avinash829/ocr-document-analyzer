# Copy this file to backend/.env for local development or configure these
# values in the backend hosting platform's environment settings.

# Server and browser access
ALLOWED_ORIGINS=http://localhost:3000

# Gemini credentials must remain backend-only. Add as many numbered keys as needed.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_ATTEMPTS=3
GEMINI_TIMEOUT_SECONDS=90
GEMINI_KEY_COOLDOWN_SECONDS=120

# Upload and processing limits
MAX_FILE_SIZE_MB=25
MAX_PAGES=30
MAX_IMAGE_DIMENSION=12000
PROCESSING_TIMEOUT_SECONDS=600
JOB_TTL_SECONDS=3600
AMBIGUOUS_THRESHOLD=0.68
